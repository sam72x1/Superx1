# Blueprint اختياري لخدمة Kronos المنفصلة. لا يغيّر render.yaml الحالي.
# القياس المحلي الفعلي لـ512 شمعة بلغ 445.81MiB؛ 512MiB لا يترك هامش إنتاج آمن.
services:
  - type: web
    name: superx1-kronos
    runtime: docker
    plan: standard
    dockerfilePath: ./services/kronos_inference/Dockerfile
    dockerContext: .
    autoDeployTrigger: off
    healthCheckPath: /health
    envVars:
      - key: KRONOS_API_TOKEN
        sync: false
      - key: KRONOS_HOST
        value: 0.0.0.0
      - key: KRONOS_PORT
        value: "10000"
      - key: KRONOS_SOURCE_REVISION
        value: 67b630e67f6a18c9e9be918d9b4337c960db1e9a
      - key: KRONOS_MODEL_REVISION
        value: 901c26c1332695a2a8f243eb2f37243a37bea320
      - key: KRONOS_TOKENIZER_REVISION
        value: 0e0117387f39004a9016484a186a908917e22426
